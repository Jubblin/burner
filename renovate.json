{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "enabledManagers": [
    "cargo",
    "npm",
    "github-actions"
  ],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "groupName": "tauri",
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchPackageNames": [
        "tauri",
        "tauri-build",
        "tauri-plugin-*",
        "@tauri-apps/*"
      ]
    },
    {
      "groupName": "cargo non-major",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!tauri",
        "!tauri-build",
        "!tauri-plugin-*"
      ]
    },
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "rangeStrategy": "pin"
    },
    {
      "isVulnerabilityAlert": true,
      "prPriority": 10,
      "matchManagers": [
        "cargo",
        "npm",
        "github-actions"
      ]
    }
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "prHourlyLimit": 2,
  "separateMajorMinor": true,
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore(deps):",
  "rangeStrategy": "auto"
}
